{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile settings including name, contact details, birth date, avatar and cloud sync state.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "gmail": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "backupEnabled": { "type": "boolean" },
        "avatarInitials": { "type": "string" },
        "avatarImage": { "type": "string" },
        "studentLevel": { "type": "string" },
        "jarvisTone": { "type": "string" },
        "selectedVoiceName": { "type": "string" },
        "googleVoiceName": { "type": "string" },
        "voiceRate": { "type": "number" },
        "voicePitch": { "type": "number" },
        "textLanguage": { "type": "string" },
        "voiceLanguage": { "type": "string" },
        "connectedAppsStr": { "type": "string" },
        "jarvisMemoriesStr": { "type": "string" },
        "chatHistoryItemsStr": { "type": "string" },
        "jarvisBehaviorRulesStr": { "type": "string" },
        "geminiKey": { "type": "string" },
        "geminiKeyPoolStr": { "type": "string" },
        "disabledGeminiKeysStr": { "type": "string" },
        "aiPlanMode": { "type": "string" },
        "appTheme": { "type": "string" },
        "jarvisVolumePreset": { "type": "string" },
        "voiceEngine": { "type": "string" },
        "baseStyleTone": { "type": "string" },
        "charWarm": { "type": "string" },
        "charEnthusiastic": { "type": "string" },
        "charHeaders": { "type": "string" },
        "charEmoji": { "type": "string" },
        "isFastAnswers": { "type": "boolean" },
        "customInstructions": { "type": "string" },
        "isReferenceMemories": { "type": "boolean" },
        "isReferenceHistory": { "type": "boolean" },
        "nicknameMemory": { "type": "string" },
        "occupationMemory": { "type": "string" },
        "moreAboutUser": { "type": "string" },
        "profileHandle": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["username"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Full chat conversation session with messages and metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "title": { "type": "string" },
        "preview": { "type": "string" },
        "timestamp": { "type": "string" },
        "updatedAt": { "type": "string" },
        "messages": { "type": "array" }
      },
      "required": ["id"]
    },
    "JarvisMemory": {
      "title": "JarvisMemory",
      "description": "Long-term remembered facts, instructions, or preferences for Jarvis.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "text"]
    },
    "JarvisBehaviorRule": {
      "title": "JarvisBehaviorRule",
      "description": "Behavioral rule and custom persona guideline for Jarvis.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rule": { "type": "string" },
        "enabled": { "type": "boolean" },
        "timestamp": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "rule"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Document holding setting parameters, personal information, and avatar data URL."
    },
    "/users/{userId}/chat_sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "Sub-collection of chat sessions and conversation threads."
    },
    "/users/{userId}/jarvis_memories/{memoryId}": {
      "schema": "JarvisMemory",
      "description": "Sub-collection of long term learned memories."
    },
    "/users/{userId}/jarvis_behavior_rules/{ruleId}": {
      "schema": "JarvisBehaviorRule",
      "description": "Sub-collection of dynamic behavioral rules."
    }
  }
}
